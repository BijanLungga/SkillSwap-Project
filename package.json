{
  "name": "skill-swap",
  "version": "1.0.0",
  "private": true,
  "description": "SkillSwap - Platform Pertukaran Keahlian Antar-Pengguna (Peer-to-Peer)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
